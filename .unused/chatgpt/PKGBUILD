# Maintainer: Akira <akira.uestc at gmail dot com>
# Releases (x86_64): https://persistent.oaistatic.com/codex-app-prod/linux/arch/x86_64/openai-chatgpt.db

pkgname=chatgpt
pkgver=26.908.70816
pkgrel=3
pkgdesc="Official ChatGPT desktop application for Linux"
arch=('x86_64')
url="https://chatgpt.com/download"
license=('LicenseRef-OpenAI-Proprietary')
options=('!strip' '!debug')
provides=('chatgpt-desktop')
conflicts=('chatgpt-desktop' 'chatgpt-bin')

# Mirrors the dependencies of OpenAI's own Arch package (chatgpt-bin).
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'libcups'
  'libdrm'
  'libgcc'
  'libglvnd'
  'libnotify'
  'libsecret'
  'libstdc++'
  'libusb'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'tar'
  'vulkan-swrast'
  'xdg-utils'
  'xz'
)

optdepends=(
  'apparmor: automatically load the bundled profile for Chromium user namespaces'
  'git: enable Git repository integration'
  'gtk4: use the GTK 4 backend with --gtk-version=4'
  'kde-cli-tools: move deleted files to the Plasma trash through kioclient'
  'org.freedesktop.secrets: securely store credentials with a Secret Service backend'
  'pipewire: enable WebRTC screen sharing under Wayland'
  'qt5-base: for Qt5 desktop integration via libqt5_shim'
  'qt6-base: for Qt6 desktop integration via libqt6_shim'
)

backup=('etc/apparmor.d/chatgpt')
install="${pkgname}.install"

# OpenAI's Arch package, from the versioned release path of its pacman
# repository so older releases stay downloadable. Upstream publishes pkgrel 1
# (its installer hardcodes it too). The local file name must not end in
# .pkg.tar.zst: the CI build script uploads every *.pkg.tar.zst it finds in
# the package directory.
source=("${pkgname}-${pkgver}-x86_64.tar.zst::https://persistent.oaistatic.com/codex-app-prod/linux/arch/${pkgver}/x86_64/chatgpt-bin-${pkgver}-1-x86_64.pkg.tar.zst"
        "${pkgname}.sh")
sha256sums=('2a6c86495f2789828356d18a55fbd9e8dbb445cb84c86f10feb704f8737d77bc'
            '5a85913807fd810bbc52796e0b0b52f42deaa541181d9848cf1886694ebafbde')

package() {
  # Only the package payload is used. Its .INSTALL (extracted next to it)
  # registers OpenAI's pacman repository and signing key, which does not
  # apply to this rebuilt package.
  cp --parents -a {etc,usr} "$pkgdir"

  # ChatGPT runs on OpenAI's own "Owl" Chromium shell, which refuses stock
  # Electron, so it keeps its bundled runtime. The upstream launcher
  # symlink (-> ../lib/chatgpt/codex-launcher) is replaced with a script
  # that also passes the flags from ~/.config/chatgpt-flags.conf.
  rm "${pkgdir}/usr/bin/chatgpt"
  install -m755 "${pkgname}.sh" "${pkgdir}/usr/bin/chatgpt"

  # Upstream installs its license under its own package name.
  mv "${pkgdir}/usr/share/licenses/chatgpt-bin" \
    "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 "${pkgdir}/usr/share/doc/chatgpt/copyright" \
    "${pkgdir}/usr/share/licenses/${pkgname}/copyright"
  ln -s /usr/lib/chatgpt/LICENSES.chromium.html \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"

  rm -r "${pkgdir}/usr/share/doc" "${pkgdir}/usr/share/lintian"
}
