  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
)
options=(!strip !debug)
_build=5446056071266304
source=(
  "${pkgname}.desktop"
  "${pkgname}.png"
  "LICENSE-Google-Antigravity"
  "LICENSE-Google"
  "Antigravity-${pkgver}-$CARCH.tar.gz::https://storage.googleapis.com/antigravity-public/antigravity-hub/${pkgver}-${_build}/linux-x64/Antigravity.tar.gz"
)
b2sums=('d6b8bf07eaeab9804e8ef82398b366d34b419287f1a2302c7764bf547a7763d1d0877bd78a29c83f8e0974659e1fc01fea674eca7e948623f92631426b198419'
        '772849ebf4574dccc7d2fc30751baed10b4a5d4091c524f3d69938192387693501c0c54ea5b43fa2ed382f70ecdff369a4c65ce3d0f778c68712fa0c2b5e84b8'
        '0458a8972be0af6f6d8c90334c5f8ddf9d2b1d2b172cabc2f7d7a4486060019f5814e2f60ecccd5b9be3cc105d4a8a041b8e64fbd2a297a89880e7764eadcfd0'
