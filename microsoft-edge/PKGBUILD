# Contributor: bittin

pkgname=microsoft-edge
_pkgshortname=msedge
pkgver=151.0.4129.107
pkgrel=1
pkgdesc="A browser that combines a minimal design with sophisticated technology to make the web faster, safer, and easier"
arch=('x86_64')
url="https://www.microsoftedgeinsider.com/en-us/download"
license=('custom')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'glib2'
  'gtk3'
  'libcups'
  'libsecret'
  'libva'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxml2'
  'libxrandr'
  'libxss'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'util-linux-libs'
)

optdepends=('pipewire: WebRTC desktop sharing under Wayland'
            'kdialog: support for native dialogs in Plasma'
            'gtk4: for --gtk-version=4 (GTK4 IME might work better on Wayland)'
            'qt6-base: for Qt6 integration'
            'org.freedesktop.secrets: password storage backend on GNOME / Xfce / Plasma'
            'upower: Battery Status API support')
options=(!strip !zipman)
source=("https://packages.microsoft.com/yumrepos/edge/Packages/m/${pkgname}-stable-${pkgver}-1.x86_64.rpm"
        "microsoft-edge.sh")
sha256sums=('a763ceb6402eba25214624fcf1f027e9bb3f19dd672874c7135a9cbea0282ab4'
            '6b11bfece9162a8ad4d45c29b2f44dc1fc1db8853c9ed81823f51f61193d15e5')

package() {

	cp --parents -a {opt,usr} "$pkgdir"
	# suid sandbox
	chmod 4755 "${pkgdir}/opt/microsoft/${_pkgshortname}/msedge-sandbox"
	# install icons
	for res in 16 24 32 48 64 128 256; do
		install -Dm644 "${pkgdir}/opt/microsoft/${_pkgshortname}/product_logo_${res}.png" \
			"${pkgdir}/usr/share/icons/hicolor/${res}x${res}/apps/${pkgname}.png"
	done
       # User flag aware launcher
       install -m755 microsoft-edge.sh "${pkgdir}/usr/bin/microsoft-edge"
       ln -sf microsoft-edge "${pkgdir}/usr/bin/microsoft-edge-stable"

       rm "${pkgdir}/opt/microsoft/${_pkgshortname}"/product_logo_*.png

       rm -f "${pkgdir}/usr/share/applications/com.microsoft.Edge.desktop"
       mv "${pkgdir}/usr/share/applications/microsoft-edge.desktop" "${pkgdir}/usr/share/applications/com.microsoft.Edge.desktop"
}
