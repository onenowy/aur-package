# Contributor: Xuanwo <xuanwo@archlinuxcn.org>

pkgname=obsidian.md
_pkgname=obsidian
pkgver=1.13.7
pkgrel=3
pkgdesc="A powerful knowledge base that works on top of a local folder of plain text Markdown files (using bundled Electron)"
arch=('x86_64')
url="https://obsidian.md"
license=('LicenseRef-Obsidian')
depends=(
  'alsa-lib'
  'bash'
  'fontconfig'
  'gtk3'
  'hicolor-icon-theme'
  'libsecret'
  'libxss'
  'nss'
  'zlib'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
install=obsidian.install
options=(!strip)
source=("obsidian.sh"
        "obsidian.desktop"
        "LICENSE-Obsidian"
        "https://github.com/obsidianmd/obsidian-releases/releases/download/v${pkgver}/obsidian-${pkgver}.tar.gz")
sha256sums=('a4f5cf374a88b686e0680532fdac2008fada514e2c2666f6cee88ff3c2dcd481'
            '99c075af3f34cb358d6e93565686792c45562b17f8002fce0e8a63b83cbbe786'
            'd9fdc14f9c2fb95bb38310281268fdad413c1b49fa93213df3184f9b0ca1175c'
            'd3cbe375cbfa4024db1910b98191649f4134c5c48aee5e60b6e7713987dcdb28')

package() {
    cd "$srcdir"

    # Install executable launcher script
    install -Dm755 "${_pkgname}.sh" "$pkgdir"/usr/bin/obsidian

    # Install desktop file
    install -Dm644 "${_pkgname}.desktop" -t "$pkgdir"/usr/share/applications/

    # Install bundled Obsidian application files to /opt/obsidian
    install -dm0755 "$pkgdir"/opt/obsidian
    cp -a "${_pkgname}-${pkgver}"/* "$pkgdir"/opt/obsidian/

    # Install desktop icon
    install -Dm644 "$pkgdir"/opt/obsidian/resources/icon.png "$pkgdir"/usr/share/icons/hicolor/512x512/apps/obsidian.png

    # Install license
    install -Dm644 "$srcdir"/LICENSE-Obsidian "$pkgdir"/usr/share/licenses/"${pkgname}"/LICENSE-Obsidian
}
