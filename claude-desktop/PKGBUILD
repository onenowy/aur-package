# Maintainer: Kevin <developer@kev314.dev>

# This PKGBUILD repackages Anthropic's official Debian package for Arch.
# Only the .deb's file payload (data.tar.xz) is used: its embedded install
# scripts do Debian/Ubuntu-specific work (apt repository registration and
# an AppArmor exception for Ubuntu's user namespace restriction), so none
# of that is reproduced here.
#
# The bundled Electron runtime is dropped: the app runs on the system
# Electron through a launcher script (see prepare() and package()).

pkgname=claude-desktop
pkgver=1.52386.6
pkgrel=2
pkgdesc="Official Claude AI desktop app from Anthropic — Chat, Cowork, and Claude Code"
arch=('x86_64')
url="https://claude.com/download"
license=('LicenseRef-Proprietary')

# Runtime dependencies. The system Electron brings the whole Chromium
# stack (gtk3, nss, alsa-lib, ...) with it; what remains is what the
# app's own components need:
#  - libraries its native binaries link directly (verified with readelf):
#    gcc-libs and glibc, plus libcap-ng and libseccomp for the bundled
#    virtiofsd;
#  - the rest of the .deb's "Depends:" field, translated to Arch names.
#    namcap flags some of these as "may not be needed": those are loaded
#    with dlopen(), spawned as programs, or used via D-Bus, all invisible
#    to namcap's ELF-header analysis. They are needed.
depends=('electron'
         'gcc-libs'
         'glibc'
         'hicolor-icon-theme'
         'libcap-ng'
         'libnotify'
         'libseccomp'
         'libsecret'
         'socat'
         'xdg-desktop-portal'
         'xdg-utils')
makedepends=('asar')

optdepends=('edk2-ovmf: UEFI firmware for Cowork VM sandbox'
            'gnome-keyring: credential storage via Secret Service (GNOME)'
            'kwallet: credential storage (KDE Plasma)'
            'libayatana-appindicator: system tray icon'
            'qemu-system-x86: QEMU hypervisor for Cowork VM sandbox'
            'virtiofsd: host directory sharing for Cowork VM sandbox'
            'xdg-desktop-portal-gtk: portal backend for GTK desktops'
            'xdg-desktop-portal-kde: portal backend for KDE Plasma')

conflicts=('claude' 'claude-desktop-bin')

# makepkg normally strips debug symbols from binaries after package().
# The remaining binaries (Cowork helpers, native Node modules) are
# prebuilt upstream: stripping saves little and risks breaking them, so
# it is disabled. !debug disables the companion -debug package, which
# only makes sense when compiling from source.
options=('!strip' '!debug')

_baseurl="https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop"
source=("${_baseurl}/${pkgname}_${pkgver}_amd64.deb"
        "${pkgname}.sh")
sha256sums=('2e83a76c6ed9187671bfe80664fc6d59840171f4a2a81f408662c879a67f4e0a'
            '42d7679e68da6143f2b1460114a368fb58ad298df700740cf6efa2ff3227503d')

prepare() {
  # A .deb is an ar archive, which makepkg unpacks like any other source:
  # $srcdir holds debian-binary, control.tar.xz (package metadata and the
  # maintainer scripts, both unused here) and data.tar.xz — the file
  # payload, which is the entire package.
  rm -rf data app
  mkdir data
  tar -xf data.tar.xz -C data

  # --- System Electron ---------------------------------------------------
  # The launcher runs "electron .../app.asar" instead of the bundled
  # Electron binary. Two things in the app's code assume the bundled
  # layout, so app.asar is unpacked, patched and repacked:
  #
  # process.resourcesPath: under the system Electron this is Electron's
  # own resources directory, but the app looks there for its files
  # (Cowork VM helpers, i18n, icons, chrome-native-host,
  # app.asar.unpacked). It is replaced with their real location.
  #
  # process.execPath: launch at login writes an autostart entry named
  # after, and executing, the running binary, which would now be bare
  # Electron. The entry is pointed at the launcher instead, keeping the
  # file name and Exec= line the bundled app used, so entries created
  # before this change keep working.
  local resources=data/usr/lib/claude-desktop/resources
  asar extract "$resources/app.asar" app
  grep -rlZ --include='*.js' -e 'process\.resourcesPath' -e 'process\.execPath' app |
    xargs -0 -r sed -i -E \
      -e 's|process\.resourcesPath|"/usr/lib/claude-desktop/resources"|g' \
      -e 's|\$\{[[:alnum:]_$.]+\.basename\(process\.execPath\)\}\.desktop|claude-desktop.desktop|g' \
      -e 's|(Exec=\$\{[[:alnum:]_$]+\()process\.execPath(\)\} --startup)|\1"/usr/lib/claude-desktop/claude-desktop"\2|g'
  rm -r "$resources/app.asar" "$resources/app.asar.unpacked"
  asar pack app "$resources/app.asar" --unpack '{*.node,github-mcp-server}'
}

package() {
  cp -a data/. "$pkgdir"

  # Everything in the app directory except resources/ is the bundled
  # Electron runtime (including its chrome-sandbox helper); the system
  # Electron replaces it. The launcher takes the old binary's place, so
  # the /usr/bin/claude-desktop symlink from the .deb still resolves.
  find "$pkgdir/usr/lib/claude-desktop" -mindepth 1 -maxdepth 1 \
    ! -name resources -exec rm -r {} +
  install -m755 "${pkgname}.sh" "$pkgdir/usr/lib/claude-desktop/claude-desktop"

  # lintian is Debian's package linter; its override file has no
  # consumer on Arch.
  rm -r "$pkgdir/usr/share/lintian"

  # --- Cowork compatibility shims -------------------------------------
  # The app hardcodes Debian's filesystem paths for the Cowork VM stack;
  # these symlinks map them to where Arch actually installs the pieces.
  #
  # virtiofsd: Debian ships it in /usr/bin, Arch in /usr/lib.
  ln -s ../lib/virtiofsd "$pkgdir/usr/bin/virtiofsd"

  # UEFI firmware: the app opens /usr/share/OVMF/OVMF_CODE_4M.fd
  # (Debian naming). On Arch, /usr/share/OVMF is a compat symlink to
  # /usr/share/edk2 (owned by our edk2-ovmf dependency), so links with
  # the Debian names are placed in /usr/share/edk2, pointing at the real
  # firmware in its x64/ subdirectory. Verified against edk2-ovmf 202605.
  install -d "$pkgdir/usr/share/edk2"
  ln -s x64/OVMF_CODE.4m.fd "$pkgdir/usr/share/edk2/OVMF_CODE_4M.fd"
  ln -s x64/OVMF_VARS.4m.fd "$pkgdir/usr/share/edk2/OVMF_VARS_4M.fd"
  #
  # Cowork's host<->VM channel also needs the vhost_vsock kernel module,
  # but no configuration is shipped for it: the module declares a
  # devname alias ("devname:vhost-vsock"), so its device node exists at
  # boot and the kernel auto-loads the module on first open (verified on
  # a live Cowork session).

  # Arch convention: every package with a non-common license installs
  # its license text under /usr/share/licenses/<pkgname>/.
  install -Dm644 "$pkgdir/usr/share/doc/claude-desktop/copyright" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
